<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {% unless page.permalink == '/' %}{{ page.title | escape }} · {% endunless %}
      Syed Ali Abbas Abedi · Molecular Design Lab
    </title>
    <meta name="description" content="{{ page.description | default: site.description | strip_html | strip | escape }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <meta property="og:title" content="{{ page.title | escape }} · Syed Ali Abbas Abedi">
    <meta property="og:description" content="{{ page.description | default: site.description | strip_html | strip | escape }}">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:type" content="website">
    {% if site.og_image %}<meta property="og:image" content="{{ site.og_image | absolute_url }}">{% endif %}
    <meta name="theme-color" content="#122a39">
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/brand/favicon.svg' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/research.css' | relative_url }}">
    <script src="{{ '/assets/js/research.js' | relative_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="{{ '/' | relative_url }}">
          {%- include research_logo.liquid -%}
          <span>Molecular Design Lab<small>Syed Ali Abbas Abedi</small></span></a
        >
        <nav aria-label="Main navigation" class="main-nav">
          <a
            href="{{ '/' | relative_url }}"
            {% if page.permalink == '/' %}
              aria-current="page"
            {% endif %}
            >About</a
          >
          <a
            href="{{ '/projects/' | relative_url }}"
            {% if page.permalink == '/projects/' %}
              aria-current="page"
            {% endif %}
            >Research</a
          >
          <a
            href="{{ '/publications/' | relative_url }}"
            {% if page.permalink == '/publications/' %}
              aria-current="page"
            {% endif %}
            >Publications</a
          >
          <a
            href="{{ '/cv/' | relative_url }}"
            {% if page.permalink == '/cv/' %}
              aria-current="page"
            {% endif %}
            >CV</a
          >
          <a
            href="{{ '/news/' | relative_url }}"
            {% if page.permalink == '/news/' %}
              aria-current="page"
            {% endif %}
            >Updates</a
          >
          <a class="nav-contact" href="{{ '/' | relative_url }}#contact">Contact ↗</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Switch to dark theme" hidden>◐</button>
      </div>
    </header>
    <main id="main" class="shell" tabindex="-1">{{ content }}</main>
    <footer class="site-footer shell">
      <div>
        <a class="footer-name" href="{{ '/' | relative_url }}">Syed Ali Abbas Abedi</a>
        <p>Computational chemistry. Molecular design. AI for materials.</p>
      </div>
      <div class="footer-links">
        <a href="{{ site.data.research.scholar_url }}">Google Scholar ↗</a><a href="{{ site.data.research.orcid_url }}">ORCID ↗</a
        ><a href="{{ '/travel/' | relative_url }}">Beyond research</a>
      </div>
      <p class="copyright">© {{ site.time | date: '%Y' }} Syed Ali Abbas Abedi · Singapore</p>
    </footer>
  </body>
</html>
