---
layout: research_base
---
{% assign researcher = site.data.research %}
<section class="hero" aria-labelledby="intro-title">
  <div class="hero-copy">
    <p class="eyebrow">{{ researcher.discipline }}</p>
    <h1 id="intro-title">
      Syed Ali Abbas<br>
      <em>Abedi.</em>
    </h1>
    <p class="hero-statement">{{ researcher.intro }}</p>
    <p class="hero-summary">{{ researcher.summary }}</p>
    <div class="link-row">
      <a class="button" href="{{ '/projects/' | relative_url }}">Explore my research ↗</a
      ><a class="text-link" href="{{ '/publications/' | relative_url }}">Read the publications →</a>
    </div>
  </div>
  <aside class="profile-panel" aria-label="Researcher profile">
    <div class="portrait-frame">
      <img
        class="portrait"
        src="{{ '/assets/img/main/profile-photo.jpg' | relative_url }}"
        alt="Syed Ali Abbas Abedi"
        width="600"
        height="680"
        fetchpriority="high"
      >
    </div>
    <div class="affiliation">
      <span class="eyebrow">{{ researcher.role }} · Singapore</span>
      <h2>{{ researcher.institution }}</h2>
      <p>{{ researcher.institute }}</p>
      <a href="{{ researcher.profile_url }}">Institutional profile ↗</a>
    </div>
  </aside>
</section>
<section class="impact-strip" aria-label="Research impact">
  <div class="impact-source">
    <p class="eyebrow">Research in numbers</p>
    <a href="{{ researcher.scholar_url }}">Google Scholar ↗</a><small>Snapshot · {{ site.data.scholar_stats.updated_at | date: '%d %b %Y' }}</small>
  </div>
  <div class="metric">
    <strong>{{ site.data.scholar_stats.citations }}</strong><span>Citations</span>
  </div>
  <div class="metric">
    <strong>{{ site.data.scholar_stats.h_index }}</strong><span>h-index</span>
  </div>
  <div class="metric">
    <strong>{{ site.data.scholar_stats.i10_index }}</strong><span>i10-index</span>
  </div>
</section>
<section class="research-section" aria-labelledby="research-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Research approach</p>
      <h2 id="research-heading">
        From mechanism<br>
        to molecular function.
      </h2>
    </div>
    <a class="text-link" href="{{ '/projects/' | relative_url }}">Research & methods ↗</a>
  </div>
  <div class="direction-grid">
    {% for direction in researcher.directions %}
      <article class="direction">
        <span class="index">0{{ forloop.index }}</span>
        <p class="eyebrow">{{ direction.label }}</p>
        <h3>{{ direction.title }}</h3>
        <p>{{ direction.text }}</p>
        <p class="methods">{{ direction.methods }}</p>
      </article>
    {% endfor %}
  </div>
</section>
<section class="research-section" aria-labelledby="papers-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Selected contributions</p>
      <h2 id="papers-heading">The work, in print.</h2>
    </div>
    <a class="text-link" href="{{ '/publications/' | relative_url }}">All publications ↗</a>
  </div>
  <div class="highlight-list">
    {% for paper in researcher.highlights %}
      <article class="highlight">
        <div class="paper-meta">
          <span>{{ paper.year }}</span><span>{{ paper.journal }}</span>
        </div>
        <div>
          <h3>
            <a href="{{ paper.url }}">{{ paper.title }} ↗</a>
          </h3>
          <p>{{ paper.text }}</p>
        </div>
      </article>
    {% endfor %}
  </div>
</section>
<section class="current-section" aria-labelledby="current-heading">
  <div>
    <p class="eyebrow">Current work · NRF Materials Data Foundry</p>
    <h2 id="current-heading">
      Learning the difference.<br>
      Accelerating discovery.
    </h2>
  </div>
  <div>
    <p class="large-copy">How can lower-cost calculations help us predict materials properties at a higher level of accuracy?</p>
    <p>
      At NUS I-FIM, I work on delta machine learning within the Materials Data Foundry project. Delta learning models the difference between levels of
      theory, building on a lower-cost prediction to approach a more accurate reference.
    </p>
    <a class="text-link" href="{{ '/projects/' | relative_url }}#ai-materials">Explore the current direction →</a>
  </div>
</section>
<section class="research-section" aria-labelledby="updates-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Recent updates</p>
      <h2 id="updates-heading">From the research desk.</h2>
    </div>
    <a class="text-link" href="{{ '/news/' | relative_url }}">All updates ↗</a>
  </div>
  {% assign recent_news = site.news | sort: 'date' | reverse -%}
  {%- for item in recent_news limit: 3 %}
    <article class="update-row">
      <time datetime="{% if item.date_precision == 'year' %}{{ item.date | date: '%Y' }}{% else %}{{ item.date | date: '%Y-%m' }}{% endif %}">
        {%- if item.date_precision == 'year' %}{{ item.date | date: '%Y' }}{% else %}{{ item.date | date: '%b %Y' }}{% endif -%}
      </time>
      <div>
        <h3>{{ item.title }}</h3>
        <div>{{ item.content | markdownify }}</div>
      </div>
    </article>
  {% endfor %}
</section>
<section id="contact" class="contact-section">
  <p class="eyebrow">Connect & collaborate</p>
  <h2>
    A molecular question<br>
    worth working on?
  </h2>
  <p>I welcome conversations about excited-state mechanisms, fluorophore design, photostability, and AI for materials discovery.</p>
  <a class="contact-email" href="mailto:{{ researcher.email }}">{{ researcher.email }} ↗</a>
  <div class="link-row">
    <a href="{{ researcher.profile_url }}">NUS profile ↗</a><a href="{{ researcher.orcid_url }}">ORCID ↗</a
    ><a href="{{ '/cv/' | relative_url }}">View CV →</a>
  </div>
</section>
