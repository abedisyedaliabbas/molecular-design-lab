---
layout: default
---
<div class="post">
  
<div class="post">
  <!-- Custom Hero Section -->
  <div class="row align-items-center mb-5 mt-4">
    <div class="col-md-8">
      <h1 class="display-3 font-weight-bold mb-3" style="font-family: var(--global-font-family-heading);">
        {% if site.title == "blank" %}
          {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      
      <div class="mb-4" style="font-size: 1.5rem; color: var(--global-theme-color);">
        <span id="rotating-tagline">Computational Chemist</span>
      </div>
      
      <div class="clearfix mb-4">
        {{ content }}
      </div>
      
      <div class="d-flex flex-wrap mb-4 mt-4">
        <a href="{{ "/publications/" | relative_url }}" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm font-weight-bold mr-3 mb-3" style="margin-right: 15px;">View Publications</a>
        <a href="{{ "/cv/" | relative_url }}" class="btn btn-outline-primary rounded-pill px-4 py-2 font-weight-bold mb-3">View CV</a>
      </div>
    </div>
    
    <div class="col-md-4 text-center d-flex flex-column justify-content-center align-items-center">
      {% if page.profile.image %}
        {% assign profile_image_path = page.profile.image | prepend: "assets/img/" %}
        {% include figure.liquid loading="eager" path=profile_image_path class="img-fluid rounded-circle shadow-lg mb-3" alt=page.profile.image cache_bust=true style="max-width: 220px; border: 4px solid var(--global-theme-color);" %}
      {% endif %}
      {% if page.profile.more_info %}
        <div class="text-muted small font-weight-bold">
          {{ page.profile.more_info }}
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Animated Stats Strip -->
  <div class="stats-strip py-4 mb-5 shadow-sm mx-auto" style="background: var(--global-card-bg-color); border-radius: 1rem; border: 1px solid var(--global-divider-color); max-width: 800px;">
    <div class="d-flex flex-wrap justify-content-center align-items-center text-center">
      <div class="px-3 px-sm-5 border-right border-end my-2" style="border-color: var(--global-divider-color) !important;">
        <h2 class="font-weight-bold mb-1" style="color: var(--global-theme-color); font-size: 2.5rem;">{{ site.data.scholar_stats.citations | default: 554 }}</h2>
        <p class="text-muted mb-0 small text-uppercase" style="letter-spacing: 1.5px; font-weight: 600;">Citations</p>
      </div>
      <div class="px-3 px-sm-5 border-right border-end my-2" style="border-color: var(--global-divider-color) !important;">
        <h2 class="font-weight-bold mb-1" style="color: var(--global-theme-color); font-size: 2.5rem;">{{ site.data.scholar_stats.h_index | default: 12 }}</h2>
        <p class="text-muted mb-0 small text-uppercase" style="letter-spacing: 1.5px; font-weight: 600;">h-index</p>
      </div>
      <div class="px-3 px-sm-5 my-2">
        <h2 class="font-weight-bold mb-1" style="color: var(--global-theme-color); font-size: 2.5rem;">{{ site.data.scholar_stats.i10_index | default: 14 }}</h2>
        <p class="text-muted mb-0 small text-uppercase" style="letter-spacing: 1.5px; font-weight: 600;">i10-index</p>
      </div>
    </div>
  </div>

  <!-- Rotating Tagline Script -->
  <script>
    const taglines = ["Computational Chemist", "AI-Driven Materials", "Photochemistry Researcher", "Molecular Designer"];
    let idx = 0;
    setInterval(() => {
      idx = (idx + 1) % taglines.length;
      const el = document.getElementById("rotating-tagline");
      el.style.opacity = 0;
      setTimeout(() => {
        el.innerText = taglines[idx];
        el.style.opacity = 1;
      }, 300);
    }, 3000);
  </script>
  <style>
    #rotating-tagline { transition: opacity 0.3s ease-in-out; }
    .border-end { border-right: 1px solid var(--global-divider-color) !important; }
  </style>


    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>
